{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth unique identifier" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Hotel room details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "description": { "type": "string" },
        "pricePerNight": { "type": "number" },
        "capacity": { "type": "integer" },
        "images": { "type": "array", "items": { "type": "string" } },
        "amenities": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["available", "maintenance"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "categoryId", "description", "pricePerNight", "capacity", "status", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Room categories (e.g., Deluxe, Suite)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "User room reservation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roomId": { "type": "string" },
        "checkIn": { "type": "string", "format": "date" },
        "checkOut": { "type": "string", "format": "date" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roomId", "checkIn", "checkOut", "totalPrice", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Hotel rooms"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Room categories"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Room bookings"
    }
  }
}
